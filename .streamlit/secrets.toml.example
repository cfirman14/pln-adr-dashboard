# ============================================================
# TEMPLATE Streamlit Secrets — JANGAN diisi kredensial asli di sini!
#
# Cara pakai:
# 1. Copy file ini jadi ".streamlit/secrets.toml" (nama file TANPA ".example")
# 2. Isi nilai-nilai di bawah dengan kredensial asli kamu
# 3. File "secrets.toml" (tanpa .example) SUDAH otomatis diabaikan oleh Git
#    (lihat .gitignore) — jadi aman, tidak akan ke-upload ke GitHub.
# 4. Untuk deploy di Streamlit Community Cloud, isi nilai yang sama lewat
#    menu: App kamu -> Settings -> Secrets (paste seluruh isi file ini).
# ============================================================

[gmail]
address = "akun-pengirim@gmail.com"
app_password = "xxxxxxxxxxxxxxxx"   # App Password 16 karakter dari Google (bukan password biasa)

[app]
sheet_id = "ID_GOOGLE_SHEET_KAMU"          # bagian di URL sheet: .../d/<ID_INI>/edit
base_url = "https://nama-app-kamu.streamlit.app"   # ganti "http://localhost:8501" kalau tes lokal

[gcp_service_account]
# Isi SELURUH isi file JSON service account dari Google Cloud Console di sini,
# dengan format TOML (bukan JSON). Contoh strukturnya:
type = "service_account"
project_id = "nama-project-gcp"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
client_email = "nama-service-account@nama-project-gcp.iam.gserviceaccount.com"
client_id = "xxxxxxxxxxxxxxxxxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/nama-service-account%40nama-project-gcp.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
